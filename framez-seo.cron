15 4 * * * root /usr/bin/flock -n /var/lock/framez-seo.lock /usr/bin/python3 /root/websites/seogeoopt/seo-jobs/framez/framez_seo_cron.py all >> /root/websites/seogeoopt/seo-jobs/framez/logs/cron.log 2>&1

# 2) 19:30 UTC (03:30 SGT / 01:00 IST): Full nightly audit, sitemap reconciliation, IndexNow, GSC, GA4, leads & report sync
30 19 * * * root /usr/bin/flock -n /var/lock/framez-seo.lock /usr/bin/python3 /root/websites/seogeoopt/seo-jobs/framez/framez_seo_cron.py all >> /root/websites/seogeoopt/seo-jobs/framez/logs/cron.log 2>&1
